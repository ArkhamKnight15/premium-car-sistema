# Premium Car — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel (produção).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA — usada somente no servidor para criar e bloquear logins de funcionários
# (tela Funcionários) e pelo script de criação do primeiro administrador.
# Nunca use prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do sistema, com https:// (usado no link de redefinição de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
